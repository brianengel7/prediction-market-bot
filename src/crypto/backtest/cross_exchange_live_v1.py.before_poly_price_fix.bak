"""Independent Kalshi + Polymarket US BTC arbitrage execution pilot.

PREVIEW by default. LIVE requires explicit verification and approval.
Two separate exchange orders are never atomic.
"""

import argparse
import asyncio
import base64
import json
import os
import time
import uuid

from decimal import Decimal as D
from pathlib import Path
from urllib.parse import urlparse

import httpx

from dotenv import load_dotenv
from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import padding, ed25519
from polymarket_us import AsyncPolymarketUS

from src.crypto import cross_exchange_arb_v2 as scan


AUDIT = Path("arb_fast_pilot_orders.jsonl")
ATTEMPT_LOCK = Path("arb_fast_live_attempt.lock")
KILL_SWITCH = Path("STOP_ARB_FAST")


def note(kind, **fields):
    record = {
        "kind": kind,
        "utc": scan.timestamp(),
        **fields,
    }

    print(
        "FAST_" + kind + " "
        + json.dumps(record, default=str),
        flush=True,
    )

    if kind in (
        "PREVIEW", "SUBMITTING", "ACK",
        "FILL_CHECK", "PAIR_FILLED",
        "UNHEDGED_HALT", "UNKNOWN_HALT",
    ):
        with AUDIT.open("a") as f:
            f.write(
                json.dumps(record, default=str) + "\n"
            )
            f.flush()
            os.fsync(f.fileno())


class UncertainSubmission(RuntimeError):
    pass


class KalshiOrders:
    """Independent authenticated Kalshi order client."""

    def __init__(self):
        self.base = os.getenv(
            "KALSHI_BASE_URL",
            "https://external-api.kalshi.com/trade-api/v2",
        ).rstrip("/")

        self.key_id = os.environ["KALSHI_API_KEY_ID"]

        self.key = serialization.load_pem_private_key(
            Path(
                os.environ["KALSHI_PRIVATE_KEY_PATH"]
            ).read_bytes(),
            password=None,
        )

        self.client = httpx.AsyncClient(
            timeout=3.0,
            limits=httpx.Limits(
                max_keepalive_connections=5
            ),
        )

    def headers(self, method, path):
        stamp = str(int(time.time() * 1000))

        message = (
            stamp
            + method.upper()
            + urlparse(self.base + path).path
        ).encode()

        if isinstance(
            self.key,
            ed25519.Ed25519PrivateKey,
        ):
            signature = self.key.sign(message)
        else:
            signature = self.key.sign(
                message,
                padding.PSS(
                    mgf=padding.MGF1(hashes.SHA256()),
                    salt_length=padding.PSS.DIGEST_LENGTH,
                ),
                hashes.SHA256(),
            )

        return {
            "KALSHI-ACCESS-KEY": self.key_id,
            "KALSHI-ACCESS-TIMESTAMP": stamp,
            "KALSHI-ACCESS-SIGNATURE":
                base64.b64encode(signature).decode(),
            "Content-Type": "application/json",
        }

    async def get(self, path, **params):
        response = await self.client.get(
            self.base + path,
            headers=self.headers("GET", path),
            params=params or None,
        )
        response.raise_for_status()
        return response.json()

    async def prewarm(self):
        return await self.get("/portfolio/balance")

    async def fok(
        self, ticker, side, price, quantity, client_id
    ):
        path = "/portfolio/events/orders"
        p = D(str(price))

        if side not in ("yes", "no") or not D(0) < p < D(1):
            raise ValueError("Invalid Kalshi order")

        yes_price = p if side == "yes" else D(1) - p

        if yes_price != yes_price.quantize(D("0.0001")):
            raise ValueError("Unsupported price precision")

        body = {
            "ticker": ticker,
            "side": "bid" if side == "yes" else "ask",
            "count": f"{D(quantity):.2f}",
            "price": f"{yes_price:.4f}",
            "time_in_force": "fill_or_kill",
            "client_order_id": client_id,
            "self_trade_prevention_type": "taker_at_cross",
            "cancel_order_on_pause": True,
        }

        started = time.perf_counter_ns()

        try:
            response = await self.client.post(
                self.base + path,
                headers=self.headers("POST", path),
                json=body,
            )
        except (
            httpx.TimeoutException,
            httpx.TransportError,
        ) as exc:
            raise UncertainSubmission(
                "Kalshi submission may have reached exchange"
            ) from exc

        elapsed = (
            time.perf_counter_ns() - started
        ) / 1e6

        if response.status_code in (408, 409) or (
            response.status_code >= 500
        ):
            raise UncertainSubmission(
                f"Kalshi HTTP {response.status_code}"
            )

        if response.status_code != 201:
            raise RuntimeError(
                f"Kalshi rejected {response.status_code}: "
                f"{response.text[:250]}"
            )

        try:
            result = response.json()
            order = result.get("order", result)
            order_id = order["order_id"]
        except Exception as exc:
            raise UncertainSubmission(
                "Kalshi accepted order but response is uncertain"
            ) from exc

        return {
            "order_id": order_id,
            "ack_ms": round(elapsed, 2),
            "raw": order,
        }

    async def fills(self, order_id):
        data = await self.get(
            "/portfolio/fills",
            order_id=order_id,
            limit=100,
        )
        return data.get("fills", [])

    async def close(self):
        await self.client.aclose()


class PolyOrders:
    """Separate official Polymarket US SDK adapter."""

    def __init__(self):
        self.client = AsyncPolymarketUS(
            key_id=os.environ["POLYMARKET_KEY_ID"],
            secret_key=os.environ["POLYMARKET_SECRET_KEY"],
            timeout=3,
            max_retries=0,
        )

    async def open(self):
        await self.client.__aenter__()
        return await self.client.account.balances()

    @staticmethod
    def payload(slug, side, price, quantity):
        p = D(str(price))

        if side not in ("yes", "no") or not D(0) < p < D(1):
            raise ValueError("Invalid Polymarket order")

        return {
            "marketSlug": slug,
            "intent": (
                "ORDER_INTENT_BUY_LONG"
                if side == "yes"
                else "ORDER_INTENT_BUY_SHORT"
            ),
            "type": "ORDER_TYPE_LIMIT",
            "price": {
                "value": str(p),
                "currency": "USD",
            },
            "quantity": int(quantity),
            "tif": "TIME_IN_FORCE_FILL_OR_KILL",
        }

    async def preview(
        self, slug, side, price, quantity
    ):
        return await self.client.orders.preview(
            self.payload(
                slug, side, price, quantity
            )
        )

    async def fok(
        self, slug, side, price, quantity
    ):
        started = time.perf_counter_ns()

        try:
            raw = await self.client.orders.create(
                self.payload(
                    slug, side, price, quantity
                )
            )
        except Exception as exc:
            if type(exc).__name__ in (
                "APITimeoutError",
                "APIConnectionError",
                "TimeoutError",
            ):
                raise UncertainSubmission(
                    "Polymarket submission state uncertain"
                ) from exc
            raise

        elapsed = (
            time.perf_counter_ns() - started
        ) / 1e6

        order = (
            raw.get("order", raw)
            if isinstance(raw, dict)
            else {}
        )

        order_id = (
            order.get("id")
            or order.get("orderId")
        )

        if not order_id:
            raise UncertainSubmission(
                "Polymarket response missing order ID"
            )

        return {
            "order_id": order_id,
            "ack_ms": round(elapsed, 2),
            "raw": order,
        }

    async def order(self, order_id):
        return await self.client.orders.retrieve(
            order_id
        )

    async def close(self):
        await self.client.__aexit__(
            None, None, None
        )


class Pilot:
    def __init__(self, args):
        self.args = args
        self.k = None
        self.p = None
        self.busy = False
        self.live_attempted = False
        self.preflight_sides = set()
        self.preview_count = 0
        self.last_preview_time = 0.0
        self.pending = set()

    async def open(self):
        self.k = KalshiOrders()
        self.p = PolyOrders()

        try:
            kb, pb = await asyncio.gather(
                self.k.prewarm(),
                self.p.open(),
            )
        except Exception:
            await self.close()
            raise

        note(
            "AUTH_OK",
            kalshi_balance_present=bool(kb),
            poly_balance_present=bool(pb),
            mode=self.args.mode,
        )

    async def close(self):
        if self.k is not None:
            await self.k.close()

        if self.p is not None:
            await self.p.close()

    def observe(self, engine, kind, legs):
        a = self.args

        if (
            kind != "CROSS_EXCHANGE"
            or self.busy
            or self.live_attempted
        ):
            return

        if len(legs) != 2 or any(
            x is None for x in legs
        ):
            return

        state = engine.state
        now = time.monotonic()

        kb = (
            state.books.get(state.kalshi_btc)
            if state.kalshi_btc else None
        )

        if not (
            kb
            and kb.ready
            and state.poly.ready
            and state.poly_slug
        ):
            return

        max_age = a.max_age_ms / 1000

        if max(
            now - kb.seen,
            now - state.poly.seen,
        ) > max_age:
            return

        if a.mode == "live":
            if (
                state.kalshi_btc != a.approved_kalshi
                or state.poly_slug != a.approved_poly
            ):
                return

        elif self.preview_count >= a.max_previews:
            return

        if now - self.last_preview_time < 3:
            return

        record = scan.priced_spread(
            "CROSS_EXCHANGE",
            legs,
            engine.args,
            {"rule_match": state.pair_status},
        )

        if record is None:
            return

        if (
            D(record["buffered_cents_per_pair"])
            < a.min_net_cents
        ):
            return

        if (
            D(record["evaluated_pairs"]) < a.qty
            or any(x.size < a.qty for x in legs)
        ):
            return

        pair = [
            (
                x.venue, x.ticker,
                x.side, str(x.price)
            )
            for x in legs
        ]

        if (
            pair[0][0] != "kalshi"
            or pair[1][0] != "polymarket_us"
        ):
            return

        self.busy = True
        self.last_preview_time = now

        task = asyncio.create_task(
            self.act(
                engine,
                pair,
                record,
                time.perf_counter_ns(),
            )
        )

        self.pending.add(task)
        task.add_done_callback(self.pending.discard)

    async def act(
        self, engine, pair, row, detected_ns
    ):
        a = self.args

        try:
            kalshi, poly = pair

            # Preview does not submit real orders.
            if (
                a.mode == "preview"
                or poly[2] not in self.preflight_sides
            ):
                started = time.perf_counter_ns()

                preview = await self.p.preview(
                    poly[1],
                    poly[2],
                    poly[3],
                    a.qty,
                )

                self.preview_count += 1
                self.preflight_sides.add(poly[2])

                note(
                    "PREVIEW",
                    direction=(
                        kalshi[2], poly[2]
                    ),
                    prices=[
                        kalshi[3], poly[3]
                    ],
                    qty=a.qty,
                    net_est_cents=row[
                        "buffered_cents_per_pair"
                    ],
                    latency_ms=round(
                        (
                            time.perf_counter_ns()
                            - started
                        ) / 1e6,
                        2,
                    ),
                    details=preview,
                )

                if a.mode == "live":
                    note(
                        "PREFLIGHT_READY",
                        message=(
                            "No orders sent on this signal. "
                            "Waiting for another fresh edge."
                        ),
                    )

                return

            # Recheck both order books.
            state = engine.state

            if (
                state.kalshi_btc != kalshi[1]
                or state.poly_slug != poly[1]
            ):
                return

            kb = state.books.get(kalshi[1])

            if not (
                kb and kb.ready and state.poly.ready
            ):
                return

            max_age = a.max_age_ms / 1000
            now = time.monotonic()

            if max(
                now - kb.seen,
                now - state.poly.seen,
            ) > max_age:
                return

            k_leg = kb.ask(
                kalshi[1],
                kalshi[2],
                max_age,
            )

            p_leg = state.poly.ask(
                poly[1],
                poly[2],
                max_age,
            )

            if not k_leg or not p_leg:
                return

            if (
                k_leg.size < a.qty
                or p_leg.size < a.qty
            ):
                return

            # Never chase worse entry prices.
            if (
                k_leg.price > D(kalshi[3])
                or p_leg.price > D(poly[3])
            ):
                return

            latest = scan.priced_spread(
                "CROSS_EXCHANGE",
                [k_leg, p_leg],
                engine.args,
            )

            if (
                latest is None
                or D(
                    latest["buffered_cents_per_pair"]
                ) < a.min_net_cents
            ):
                return

            if (
                k_leg.price + p_leg.price
                > a.max_combined_price
            ):
                return

            if KILL_SWITCH.exists():
                return

            self.live_attempted = True
            client_id = str(uuid.uuid4())

            # Durable lock prevents duplicate attempts.
            try:
                fd = os.open(
                    ATTEMPT_LOCK,
                    os.O_CREAT | os.O_EXCL | os.O_WRONLY,
                    0o600,
                )
            except FileExistsError:
                note(
                    "UNKNOWN_HALT",
                    message="Existing live-attempt lock",
                )
                return

            with os.fdopen(fd, "w") as f:
                f.write(json.dumps({
                    "at": scan.timestamp(),
                    "client_order_id": client_id,
                    "kalshi": kalshi[1],
                    "poly": poly[1],
                }) + "\n")
                f.flush()
                os.fsync(f.fileno())

            note(
                "SUBMITTING",
                pair=pair,
                client_id=client_id,
                qty=a.qty,
                observed_to_submit_ms=round(
                    (
                        time.perf_counter_ns()
                        - detected_ns
                    ) / 1e6,
                    2,
                ),
                net_est_cents=latest[
                    "buffered_cents_per_pair"
                ],
            )

            # Concurrent FOK is NOT atomic.
            k_result, p_result = await asyncio.gather(
                self.k.fok(
                    kalshi[1], kalshi[2],
                    kalshi[3], a.qty, client_id,
                ),
                self.p.fok(
                    poly[1], poly[2],
                    poly[3], a.qty,
                ),
                return_exceptions=True,
            )

            note(
                "ACK",
                kalshi=(
                    repr(k_result)
                    if isinstance(k_result, Exception)
                    else k_result
                ),
                poly=(
                    repr(p_result)
                    if isinstance(p_result, Exception)
                    else p_result
                ),
            )

            if (
                isinstance(k_result, Exception)
                or isinstance(p_result, Exception)
            ):
                note(
                    "UNKNOWN_HALT",
                    message=(
                        "One or both order states uncertain. "
                        "Reconcile before any other attempt."
                    ),
                )
                return

            # ACK does not mean filled.
            await asyncio.sleep(0.2)

            k_fills, p_order = await asyncio.gather(
                self.k.fills(k_result["order_id"]),
                self.p.order(p_result["order_id"]),
            )

            k_qty = sum(
                (
                    D(str(f.get(
                        "count_fp",
                        f.get("count", "0"),
                    )))
                    for f in k_fills
                ),
                D(0),
            )

            p_record = (
                p_order.get("order", p_order)
                if isinstance(p_order, dict)
                else {}
            )

            p_qty = D(str(
                p_record.get(
                    "cumQuantity",
                    p_record.get("cumQty", "0"),
                )
            ))

            k_cost = sum(
                (
                    D(str(f.get(
                        "count_fp",
                        f.get("count", "0"),
                    )))
                    * D(str(f.get(
                        (
                            "yes_price_dollars"
                            if kalshi[2] == "yes"
                            else "no_price_dollars"
                        ),
                        "0",
                    )))
                    for f in k_fills
                ),
                D(0),
            )

            k_fees = sum(
                (
                    D(str(f.get(
                        "fee_cost", "0"
                    )))
                    for f in k_fills
                ),
                D(0),
            )

            p_avg = p_record.get("avgPx")

            if isinstance(p_avg, dict):
                p_avg = p_avg.get("value")

            note(
                "FILL_CHECK",
                kalshi_filled=str(k_qty),
                polymarket_filled=str(p_qty),
                polymarket_status=p_record.get(
                    "state", "UNKNOWN"
                ),
                kalshi_cost=str(k_cost),
                kalshi_actual_fees=str(k_fees),
                polymarket_avg_price=str(p_avg),
                kalshi_raw_fills=k_fills,
                poly_order=p_record,
            )

            if (
                k_qty != D(a.qty)
                or p_qty != D(a.qty)
            ):
                note(
                    "UNHEDGED_HALT",
                    message=(
                        "Missing or unmatched fill. "
                        "Stop and reconcile both accounts."
                    ),
                )
            else:
                note(
                    "PAIR_FILLED",
                    message=(
                        "Matched quantities observed. "
                        "Verify actual prices, fees and "
                        "settlement before claiming profit."
                    ),
                )

        except Exception as exc:
            note(
                "UNKNOWN_HALT",
                error=(
                    f"{type(exc).__name__}: "
                    f"{str(exc)[:250]}"
                ),
            )

        finally:
            self.busy = False


def arguments():
    ap = argparse.ArgumentParser()

    ap.add_argument(
        "--mode",
        choices=["preview", "live"],
        default="preview",
    )
    ap.add_argument(
        "--minutes", type=float, default=30
    )
    ap.add_argument(
        "--qty", type=int, default=1
    )
    ap.add_argument(
        "--min-net-cents",
        type=D, default=D("5"),
    )
    ap.add_argument(
        "--max-age-ms",
        type=float, default=100,
    )
    ap.add_argument(
        "--max-combined-price",
        type=D, default=D("0.90"),
    )
    ap.add_argument(
        "--max-previews",
        type=int, default=3,
    )
    ap.add_argument("--approved-kalshi")
    ap.add_argument("--approved-poly")
    ap.add_argument(
        "--rules-and-fees-verified",
        action="store_true",
    )
    ap.add_argument(
        "--accept-leg-risk",
        action="store_true",
    )
    ap.add_argument(
        "--balances-confirmed",
        action="store_true",
    )
    ap.add_argument(
        "--self-test",
        action="store_true",
    )

    ap.add_argument(
        "--with-weather",
        action="store_true",
        help="Include NYC and Miami Kalshi weather books",
    )
    return ap.parse_args()


async def main():
    args = arguments()

    if args.self_test:
        assert PolyOrders.payload(
            "demo", "no", "0.45", 1
        )["intent"] == "ORDER_INTENT_BUY_SHORT"

        assert PolyOrders.payload(
            "demo", "yes", "0.55", 1
        )["tif"] == "TIME_IN_FORCE_FILL_OR_KILL"

        print(
            "PASS: Order construction self-test. "
            "No orders submitted."
        )
        return

    if (
        args.qty != 1
        or not D(0)
        < args.max_combined_price
        < D(1)
    ):
        raise SystemExit(
            "Pilot requires qty=1 and combined price below $1"
        )

    if (
        args.minutes <= 0
        or args.max_age_ms <= 0
        or args.min_net_cents < 0
    ):
        raise SystemExit("Invalid settings")

    load_dotenv(
        dotenv_path=(
            Path(__file__).resolve().parents[3]
            / ".env"
        )
    )

    if args.mode == "live":
        if not (
            os.getenv(
                "KALSHI_LIVE_TRADING_ENABLED", ""
            ).lower() == "true"
            and args.approved_kalshi
            and args.approved_poly
            and args.rules_and_fees_verified
            and args.accept_leg_risk
            and args.balances_confirmed
        ):
            raise SystemExit(
                "LIVE BLOCKED: explicit verification and "
                "approval required"
            )

        if ATTEMPT_LOCK.exists():
            raise SystemExit(
                "LIVE BLOCKED: previous attempt unresolved"
            )

        if KILL_SWITCH.exists():
            raise SystemExit(
                "LIVE BLOCKED: STOP_ARB_FAST exists"
            )

    pilot = Pilot(args)
    await pilot.open()

    original_consider = scan.Engine.consider

    def wrapped(
        engine, kind, legs,
        extra=None, family=None
    ):
        if kind == "CROSS_EXCHANGE":
            pilot.observe(engine, kind, legs)

        return original_consider(
            engine, kind, legs, extra, family
        )

    scan.Engine.consider = wrapped

    scan_args = argparse.Namespace(
        minutes=args.minutes,
        log_db=False,
        extra_kalshi_series=(
            ["KXTEMPNYCHS", "KXTEMPMIAH"]
            if args.with_weather else []
        ),
        max_extra=12,
        max_age=args.max_age_ms / 1000,
        min_qty=D("1"),
        eval_qty=D(str(args.qty)),
        min_edge=args.min_net_cents / 100,
        kalshi_rate=D("0.07"),
        poly_rate=D("0.0695"),
        slip=D("0.01"),
        k_fee=D("0.02"),
        p_fee=D("0.02"),
        cooldown=3,
        status_every=10,
        close_buffer=5,
        exhaustive_set=[],
        exclusive_set=[],
        no_weather=not args.with_weather,
    )

    note(
        "READY",
        mode=args.mode,
        min_net_cents=str(args.min_net_cents),
        quantity=args.qty,
        max_age_ms=args.max_age_ms,
    )

    try:
        await scan.run(scan_args)

    finally:
        scan.Engine.consider = original_consider

        if pilot.pending:
            await asyncio.gather(
                *tuple(pilot.pending),
                return_exceptions=True,
            )

        await pilot.close()


if __name__ == "__main__":
    asyncio.run(main())
